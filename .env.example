# ============================================================
# PA Review Platform — Environment Configuration Template
#
# Usage:
#   cp .env.example .env
#   Edit .env with real values for your environment
#
# Rules:
#   - NEVER commit .env to version control
#   - All SecretStr fields must have real values in production
#   - Required fields marked (REQUIRED) — no default, must be set
#   - Fields with defaults shown can be omitted in development
# ============================================================


# ============================================================
# APPLICATION
# ============================================================

APP_NAME="PA Review Platform"
APP_VERSION="0.1.0"

# Values: development | staging | production
ENVIRONMENT=development

# Set false in staging/production (enforced by settings validator)
DEBUG=true


# ============================================================
# API
# ============================================================

API_PREFIX=/api/v1
API_TITLE="AI-Assisted Prior Authorization Review Platform"

# JSON array — TrustedHostMiddleware allowlist (tighten in production)
ALLOWED_HOSTS=["localhost","127.0.0.1"]


# ============================================================
# SECURITY  (REQUIRED in all environments)
# ============================================================

# Generate with: openssl rand -hex 32
# REQUIRED — app will not start without this
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# ============================================================
# CORS
# ============================================================

# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true


# ============================================================
# DATABASE — MySQL / MariaDB
# ============================================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=pa_review_db
DB_USER=pa_user
DB_PASSWORD=pa_password

# Connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
# Recycle stale connections every 30 minutes
DB_POOL_RECYCLE=1800

# Never true in production (leaks PHI to logs)
DB_ECHO=false


# ============================================================
# REDIS — Caching & Session Store
# ============================================================

# Format: redis://[user:password@]host:port/db
REDIS_URL=redis://localhost:6379/0

# Leave blank if no AUTH required
REDIS_PASSWORD=

# Default cache TTL when no domain-specific TTL is set (seconds)
REDIS_TTL=3600

REDIS_MAX_CONNECTIONS=20


# ============================================================
# PINECONE — Vector Database
# ============================================================

# REQUIRED for retrieval and policy ingestion
PINECONE_API_KEY=your-pinecone-api-key

# Serverless region (e.g. us-east-1-aws, eu-west-1-aws, us-west-2-aws)
PINECONE_ENVIRONMENT=us-east-1-aws

# Index name — created automatically on first startup if absent
PINECONE_INDEX_NAME=pa-policies

# Default namespace — override per-request for multi-tenant isolation
PINECONE_NAMESPACE=production


# ============================================================
# OPENAI — LLM & Embeddings
# ============================================================

# REQUIRED for all AI features
OPENAI_API_KEY=your-openai-api-key

# Chat / reasoning model
OPENAI_MODEL=gpt-4o

# Maximum output tokens for LLM responses
OPENAI_MAX_TOKENS=4096

# Keep 0.0 for deterministic medical reasoning — never raise in production
OPENAI_TEMPERATURE=0.0

# HTTP timeout for OpenAI API calls (seconds)
OPENAI_REQUEST_TIMEOUT=60

# Embedding model — changing this requires re-indexing all policies
# Options: text-embedding-3-small (1536d) | text-embedding-3-large (3072d)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# ============================================================
# AZURE AI DOCUMENT INTELLIGENCE — Primary OCR
# ============================================================

# Leave blank to skip Azure and fall through to PaddleOCR
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-azure-key

# Re-run page through PaddleOCR if Azure confidence drops below this
AZURE_OCR_CONFIDENCE_THRESHOLD=0.80

# Azure polling timeout (seconds)
AZURE_OCR_TIMEOUT=30


# ============================================================
# POLICY INGESTION PIPELINE
# ============================================================

# Enable OCR fallback for text-poor / scanned PDFs
INGESTION_OCR_ENABLED=true

# Reject PDFs larger than this (bytes). Default 50 MB.
INGESTION_MAX_PDF_BYTES=52428800

# Minimum average characters per page before triggering OCR fallback
INGESTION_OCR_THRESHOLD_CHARS=80

# Chunker: approximate target size in tokens per criterion chunk
INGESTION_CHUNK_TOKENS=512

# Chunker: overlap between adjacent chunks (tokens)
INGESTION_OVERLAP_TOKENS=50


# ============================================================
# LANGSMITH — LangChain Tracing & Evaluation
# ============================================================

# Leave blank to disable tracing (safe for development)
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=pa-review-platform

# Set true to enable LangChain request tracing to LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com


# ============================================================
# EVALUATION FRAMEWORK — DeepEval & RAGAS
# ============================================================

# Used by offline evaluation scripts (not the runtime application)
DEEPEVAL_API_KEY=your-deepeval-api-key

# RAGAS uses the same OpenAI key — no separate credential needed
# Set the run name for experiment tracking
RAGAS_EXPERIMENT_NAME=pa-retrieval-eval-v1


# ============================================================
# RABBITMQ — Async Task Queue
# ============================================================

# Format: amqp://user:password@host:port/vhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Queue names — must match consumer configuration
RABBITMQ_PA_QUEUE=pa.requests
RABBITMQ_NOTIFICATION_QUEUE=pa.notifications

# Max unacked messages per consumer
RABBITMQ_PREFETCH_COUNT=10


# ============================================================
# LOGGING
# ============================================================

# Values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Values: json (structured, for log aggregators) | console (human-readable)
LOG_FORMAT=console


# ============================================================
# RATE LIMITING
# ============================================================

# Max requests per window per client IP
RATE_LIMIT_REQUESTS=100

# Window duration (seconds)
RATE_LIMIT_WINDOW=60


# ============================================================
# MONITORING — Prometheus
# ============================================================

PROMETHEUS_ENABLED=true
PROMETHEUS_ENDPOINT=/metrics


# ============================================================
# FILE UPLOAD
# ============================================================

# Maximum single-file upload size (bytes). Default 50 MB.
MAX_UPLOAD_SIZE_BYTES=52428800

# JSON array of permitted file extensions
ALLOWED_UPLOAD_EXTENSIONS=[".pdf",".png",".jpg",".jpeg",".tiff",".json",".txt"]


# ============================================================
# PRODUCTION DEPLOYMENT (used by gunicorn / Docker entrypoint)
# These are read by the container entrypoint, not by Settings.
# ============================================================

# Number of Gunicorn worker processes
# Recommended: (2 × CPU cores) + 1
GUNICORN_WORKERS=4

# Worker class — uvicorn workers for ASGI
GUNICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker

# Gunicorn request timeout (seconds)
GUNICORN_TIMEOUT=120

# Bind address
GUNICORN_BIND=0.0.0.0:8000
