# ============================================================
# PA Review Platform — Environment Configuration Template
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
APP_NAME="PA Review Platform"
APP_VERSION="0.1.0"
# Values: development | staging | production
ENVIRONMENT=development
DEBUG=true
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# ----------------------------------------------------------
# API
# ----------------------------------------------------------
API_PREFIX=/api/v1
API_TITLE="AI-Assisted Prior Authorization Review Platform"
# Comma-separated hostnames for TrustedHostMiddleware (production)
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true

# ----------------------------------------------------------
# Database (MySQL)
# ----------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pa_review_db
DB_USER=pa_user
DB_PASSWORD=pa_password
# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ----------------------------------------------------------
# Redis
# ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Leave blank if no auth
REDIS_PASSWORD=
# Default TTL in seconds (1 hour)
REDIS_TTL=3600
REDIS_MAX_CONNECTIONS=20

# ----------------------------------------------------------
# Pinecone
# ----------------------------------------------------------
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=pa-policies
PINECONE_NAMESPACE=production

# ----------------------------------------------------------
# OpenAI
# ----------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
# Keep at 0.0 for deterministic medical reasoning
OPENAI_TEMPERATURE=0.0
OPENAI_REQUEST_TIMEOUT=60

# ----------------------------------------------------------
# Azure AI Document Intelligence (Primary OCR)
# ----------------------------------------------------------
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-azure-key
# Trigger PaddleOCR fallback if confidence drops below this
AZURE_OCR_CONFIDENCE_THRESHOLD=0.80
AZURE_OCR_TIMEOUT=30

# ----------------------------------------------------------
# LangSmith (Evaluation & Tracing)
# ----------------------------------------------------------
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=pa-review-platform
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ----------------------------------------------------------
# RabbitMQ (Async Queue)
# ----------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_PA_QUEUE=pa.requests
RABBITMQ_NOTIFICATION_QUEUE=pa.notifications
RABBITMQ_PREFETCH_COUNT=10

# ----------------------------------------------------------
# Logging
# ----------------------------------------------------------
# Values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Values: json | console
LOG_FORMAT=json

# ----------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------
# Max requests per window per client
RATE_LIMIT_REQUESTS=100
# Window size in seconds
RATE_LIMIT_WINDOW=60

# ----------------------------------------------------------
# Monitoring
# ----------------------------------------------------------
PROMETHEUS_ENABLED=true
PROMETHEUS_ENDPOINT=/metrics

# ----------------------------------------------------------
# Security
# ----------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------
# Upload Settings
# ----------------------------------------------------------
# Maximum file size in bytes (50 MB)
MAX_UPLOAD_SIZE_BYTES=52428800
ALLOWED_UPLOAD_EXTENSIONS=[".pdf",".png",".jpg",".jpeg",".tiff",".json",".txt"]
